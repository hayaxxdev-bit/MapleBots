# ============================================
# Bot Configuration
# ============================================ (untuk perintah khusus admin)
OWNER_NUMBER=62xxxxxxxxx

# Co-owner/Admin numbers (comma-separated)
ADMIN_NUMBERS=62xxxxx, 62xxxxxx

# Bot mode: public, private, group_only
BOT_MODE=public

# Allowed groups (if group_only mode)
ALLOWED_GROUPS=

# .env (Updated - Add web dashboard config)
# Web Dashboard Configuration
WEB_DASHBOARD_ENABLED=true
WEB_DASHBOARD_PORT=3000
WEB_DASHBOARD_AUTH=false
WEB_DASHBOARD_USERNAME=admin
WEB_DASHBOARD_PASSWORD=admin123

# ============================================
# Scraper Configuration
# ============================================

# Primary Scraper Sources
ANIME_SCRAPER=otakudesu
MANGA_SCRAPER=komiku
DOUJIN_SCRAPER=nhentai
WAIFU_IM=waifu_im
NEKOS_API=nekos_best

# Alternative scrapers (fallback)
ANIME_SCRAPER_FALLBACK=samehadaku,anoboy,kuramanime
MANGA_SCRAPER_FALLBACK=mangaku,mangadex

# Scraper endpoints (customizable)
OTAKUDESU_URL=https://otakudesu.blog/
WAIFU_IM=https://api.waifu.im/
SAMEHADAKU_URL=https://v2.samehadaku.how/
ANOBOY_URL=https://anoboy.xyz/
KURAMANIME_URL=https://v19.kuramanime.ing/
NEKOS_API=https://nekos.best/api/
KOMIKU_URL=https://komiku.org/
MANGADEK_URL=https://mangadex.org/

APIFY_API_TOKEN=
RAPIDAPI_KEY=
# Scraper request settings
SCRAPER_TIMEOUT=15000
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPER_MAX_CONCURRENT=3
SCRAPER_CACHE_ENABLED=true
SCRAPER_CACHE_TTL=3600

# ============================================
# Custom API Configuration (Optional)
# ============================================

# Enable/disable external APIs
USE_JIKAN_API=false
USE_TRACE_MOE=false

# Jikan API (MyAnimeList) - Optional fallback
JIKAN_BASE_URL=https://api.jikan.moe/v4
JIKAN_RATE_LIMIT=5
JIKAN_TIMEOUT=10000

# Trace.moe API - Optional
TRACE_MOE_URL=https://api.trace.moe/search
TRACE_MOE_TIMEOUT=15000

# Custom API endpoints (for future use)
CUSTOM_API_1=
CUSTOM_API_2=
CUSTOM_API_3=

# API Key configuration (if needed)
WAIFU_IM_API_KEY=
TRACE_MOE_API_KEY=
CUSTOM_API_KEY=

# ============================================
# Downloader Configuration (Scraper-based)
# ============================================

# YouTube Download (scraping method)
YOUTUBE_TIMEOUT=30000
YOUTUBE_MAX_SIZE=100
YOUTUBE_SCRAPER=yt-dlp
YOUTUBE_QUALITY=720p
YOUTUBE_AUDIO_ONLY=false

# TikTok Download
TIKTOK_TIMEOUT=20000
TIKTOK_SCRAPER=tikwm
TIKTOK_WITH_WATERMARK=false
TIKTOK_MUSIC_EXTRACT=true

# Instagram Download
INSTAGRAM_TIMEOUT=20000
INSTAGRAM_SCRAPER=snapinsta
INSTAGRAM_TYPE=all

# Facebook Download
FACEBOOK_TIMEOUT=20000
FACEBOOK_SCRAPER=fdown
FACEBOOK_HD=true

# Twitter/X Download
TWITTER_TIMEOUT=20000
TWITTER_SCRAPER=twdown
TWITTER_URL=https://twdown.net/api

# Downloader scraper endpoints (customizable)
YTDLP_PATH=./bin/yt-dlp
YTDLP_FORMAT=best[height<=720]
TIKWM_URL=https://www.tikwm.com/api/
SNAPINSTA_URL=https://snapinsta.app/api
FDOWN_URL=https://fdown.net/api

# Download limits
MAX_DOWNLOAD_SIZE=100
DOWNLOAD_QUALITY=auto
CONCURRENT_DOWNLOADS=2

# ============================================
# Bot Behavior
# ============================================

# Auto read messages
AUTO_READ=true

# Auto typing indicator
AUTO_TYPING=true

# Auto recording indicator
AUTO_RECORDING=false

# Maximum retry attempts for failed operations
MAX_RETRY_ATTEMPTS=3

# Delay between retries (ms)
RETRY_DELAY_MS=1000

# Scraper retry with fallback
SCRAPER_FALLBACK_ENABLED=true

# Anti-spam configuration
ANTI_SPAM_ENABLED=true
MAX_COMMANDS_PER_MINUTE=10
COOLDOWN_PER_COMMAND=3000

# Command settings
COMMAND_CASE_SENSITIVE=false
ALLOW_COMMAND_IN_GROUP=true
ALLOW_COMMAND_IN_PM=true

INSTAGRAM_COOKIES_PATH=./secrets/instagram_cookies.txt
# ============================================
# Media Processing
# ============================================

# Temporary directory for media processing
TEMP_DIR=./temp

# Auto cleanup temp files (minutes)
TEMP_CLEANUP_INTERVAL=30

# Maximum file size to process (MB)
MAX_FILE_SIZE_MB=50

# Image processing
IMAGE_COMPRESSION_ENABLED=true
IMAGE_MAX_WIDTH=1280
IMAGE_QUALITY=80

# Video processing
VIDEO_COMPRESSION_ENABLED=false
VIDEO_MAX_DURATION=300

# Sticker processing
STICKER_MAX_SIZE=512
STICKER_FORMAT=webp

# ============================================
# Database Configuration
# ============================================

# Database type: json, sqlite, mongodb
DATABASE_TYPE=json

# SQLite database path
SQLITE_PATH=./data/maplebot.db

# MongoDB connection (if using mongodb)
MONGODB_URI=
MONGODB_DB_NAME=maplebot

# JSON database path
JSON_DB_PATH=./data/database.json

# Cache configuration
CACHE_ENABLED=true
CACHE_TYPE=memory
REDIS_URL=redis://localhost:6379

# ============================================
# Logging
# ============================================

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
LOG_FILE_COMBINED=./logs/combined.log
LOG_FILE_ERROR=./logs/error.log
LOG_ROTATION_ENABLED=true
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5
BAILEYS_LOG_LEVEL=warn

# Console Output
CONSOLE_LOG_STYLE=pretty    # pretty, minimal, json
CONSOLE_LOG_COLORS=true 
CONSOLE_LOG_TIMESTAMP=true
CONSOLE_LOG_EMOJI=true
# ============================================
# Session Configuration
# ============================================

# Session directory
SESSION_DIR=./data/sessions

# Auto save session interval (ms)
SESSION_SAVE_INTERVAL=10000

# Session encryption
SESSION_ENCRYPTION=true
SESSION_PASSWORD=

# ============================================
# Feature Flags
# ============================================

# Enable/disable features
FEATURE_ANIME=true
FEATURE_MANGA=true
FEATURE_DOWNLOADER=true
FEATURE_WAIFU=true
FEATURE_NEKOS=true
FEATURE_STICKER=true
FEATURE_TRANSLATE=true
FEATURE_WEATHER=true
FEATURE_NEWS=true
FEATURE_GAME=true
FEATURE_MUSIC=true

# ============================================
# Localization
# ============================================

# Default language
DEFAULT_LANGUAGE=id
TIMEZONE=Asia/Jakarta
DATE_FORMAT=DD/MM/YYYY
TIME_FORMAT=HH:mm:ss

# ============================================
# Performance
# ============================================

# Node.js settings
NODE_ENV=development
MAX_MEMORY_USAGE=512
WORKER_THREADS=2

# Queue configuration
QUEUE_ENABLED=true
MAX_QUEUE_SIZE=100
QUEUE_PROCESS_DELAY=500

# ============================================
# Security
# ============================================

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=50
RATE_LIMIT_WINDOW=60000

# Allowed domains (for security)
ALLOWED_DOMAINS=youtube.com,youtu.be,tiktok.com,instagram.com,facebook.com,twitter.com

# Blocked commands (comma-separated)
BLOCKED_COMMANDS=

# ============================================
# Notification
# ============================================

# Error notification
NOTIFY_ON_ERROR=true
NOTIFY_ON_CRASH=true
NOTIFY_CHANNEL=owner
NOTIFY_ON_START=true
NOTIFY_ON_STOP=true
NOTIFY_ON_RECONNECT=true
NOTIFY_ON_LOGIN=true
# Update checker
CHECK_UPDATES=true
UPDATE_INTERVAL=86400