{
  "name": "maple-bots",
  "version": "1.0.7",
  "description": "Advanced WhatsApp Bot with TypeScript, featuring downloader, anime services, utilities, monitoring and dashboard infrastructure using Baileys.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon",
    "dev:ts": "ts-node -r tsconfig-paths/register src/index.ts",
    "build": "pnpm clean:build && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "setup:gallery-dl": "node scripts/setup-gallery-dl.js",
    "clean": "pnpm clean:build && pnpm clean:runtime",
    "clean:build": "rimraf dist",
    "clean:runtime": "rimraf logs/*.log temp/*",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"public/**/*.{html,css,js}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"public/**/*.{html,css,js}\"",
    "check": "pnpm lint && pnpm type-check && pnpm format:check",
    "test": "pnpm type-check",
    "cache:clear": "rimraf .cache/*",
    "session:clean": "node scripts/clean-session.js",
    "session:clean:dry": "node scripts/clean-session.js --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "@distube/ytdl-core": "latest",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.2.0",
    "file-type": "^16.5.4",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "moment-timezone": "^0.5.45",
    "node-cache": "^5.1.2",
    "p-limit": "^5.0.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.62.1",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "yt-dlp-exec": "^1.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cheerio": "^0.22.35",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^22.10.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/sharp": "^0.32.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.2.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "typescript",
    "downloader",
    "anime",
    "scraper",
    "dashboard"
  ],
  "author": "hayaxxdev-bit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hayaxxdev-bit/MapleBots.git"
  }
}
