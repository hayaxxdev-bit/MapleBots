# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# TypeScript and JavaScript
[*.{ts,tsx,js,jsx}]
indent_size = 2
indent_style = space
quote_type = single

# JSON
[*.json]
indent_size = 2
indent_style = space

# Markdown
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2
indent_style = space

# Package files
[package.json]
indent_size = 2

# Environment files
[.env]
indent_size = 2

# Git files
[.gitignore]
indent_size = 2