{
  "watch": ["src", ".env"],
  "ext": "ts,json,env",
  "ignore": [
    "src/**/*.spec.ts",
    "node_modules",
    "dist",
    "sessions",
    "temp",
    "logs",
    "tests",
    ".cache",
    "data"
  ],
  "exec": "ts-node -r tsconfig-paths/register src/index.ts",
  "env": {
    "NODE_ENV": "development",
    "TS_NODE_TRANSPILE_ONLY": "true"
  },
  "delay": 1000,
  "verbose": false,
  "restartable": "rs",
  "events": {
    "restart": "clear || cls"
  }
}